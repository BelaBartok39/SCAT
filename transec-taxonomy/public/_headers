# Cloudflare Pages header rules. Copied verbatim into dist/ by Vite.

# Asset filenames are content-hashed by Vite, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell must be revalidated so a deploy is picked up immediately.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
